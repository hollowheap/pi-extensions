{
  "name": "@hollowheap/pi-tasks",
  "version": "0.3.0",
  "type": "module",
  "description": "Durable background shell tasks for the Pi coding agent",
  "license": "MIT",
  "engines": {
    "node": ">=22.19.0"
  },
  "keywords": ["pi-package"],
  "files": ["index.ts", "src", "README.md"],
  "exports": {
    ".": "./index.ts",
    "./*": "./src/*.ts"
  },
  "pi": {
    "extensions": ["./index.ts"]
  },
  "dependencies": {
    "@hollowheap/core": "^0.3.0",
    "@hollowheap/runtime": "^0.3.0",
    "@hollowheap/tui": "^0.3.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "publishConfig": {
    "access": "public"
  }
}
