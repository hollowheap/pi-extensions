{
  "name": "pi-extensions",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Powerpack extensions for the Pi coding agent: guardrails, statusline, budgeting, autopilot, and power tools",
  "license": "MIT",
  "engines": {
    "node": ">=22.19.0"
  },
  "keywords": ["pi-package"],
  "workspaces": ["packages/*", "extensions/*"],
  "pi": {
    "extensions": [
      "./extensions/pi-statusline/index.ts",
      "./extensions/pi-guard/index.ts",
      "./extensions/pi-hooks/index.ts",
      "./extensions/pi-question/index.ts",
      "./extensions/pi-dashboard/index.ts",
      "./extensions/pi-tools/index.ts",
      "./extensions/pi-budgets/index.ts",
      "./extensions/pi-autopilot/index.ts",
      "./extensions/pi-todos/index.ts",
      "./extensions/pi-code-intel/index.ts",
      "./extensions/pi-tasks/index.ts",
      "./extensions/pi-classifier/index.ts"
    ]
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "clean": "tsc -b --clean && rm -rf node_modules packages/*/node_modules",
    "new": "node scripts/new-extension.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": "*",
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  }
}
